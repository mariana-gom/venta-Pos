{
  "expo": {
    "name": "DANNY'S POS",
    "slug": "venta-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "ventapos",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ventapos.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Conectar con el servidor de tu negocio en la red local."
      }
    },
    "android": {
      "package": "com.ventapos.mobile"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-sharing"
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/dannys-logo.png",
      "name": "DANNY'S POS",
      "themeColor": "#1E7A3C"
    },
    "platforms": [
      "android",
      "web"
    ]
  }
}
