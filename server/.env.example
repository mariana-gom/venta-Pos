HOST=127.0.0.1
PORT=4317
DATABASE_PATH=./data/pos.sqlite
# El asistente de creación solicita los datos si estas variables no están presentes.
# ADMIN_USERNAME=
# ADMIN_NAME=
# ADMIN_PASSWORD=
# Separar con comas los orígenes web permitidos. Las apps nativas no necesitan CORS.
CORS_ORIGINS=http://localhost:8097,http://127.0.0.1:8097
# Solo detrás de un proxy (Railway, Render, Nginx): número de saltos de confianza. Vacío en local.
# TRUST_PROXY=1
# Carpeta de copias de `npm run backup`; en hosting, dentro del disco persistente.
# BACKUP_DIR=./backups

# Zona IANA del negocio para permisos, filtros y reportes del historial.
BUSINESS_TIME_ZONE=America/Bogota
